# Copy to apps/api/.env for local development.
APP_ENV=local
PORT=3000

# Runtime connection: the least-privileged role, subject to row-level security.
DATABASE_URL=postgres://skydra_app:skydra_app@localhost:5433/skydra
# Schema owner (not a superuser), used only by `pnpm db:migrate` and seeding. Never given to the API.
MIGRATION_DATABASE_URL=postgres://skydra_migrator:skydra_migrator@localhost:5433/skydra
# Superuser connection for integration tests; each test file creates its own database.
TEST_DATABASE_URL=postgres://skydra:skydra@localhost:5433/skydra

# Provider adapters: MOCK | MANUAL | ONDATO. MOCK is refused when APP_ENV=prod.
SCREENING_PROVIDER=MOCK
IDENTITY_PROVIDER=MOCK
REGISTRY_PROVIDER=MOCK

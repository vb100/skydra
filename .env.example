# Copy to apps/api/.env for local development.
APP_ENV=local
PORT=3000
# Origin the browser uses: invitation links and the Origin check use it.
PUBLIC_APP_URL=http://localhost:5173
# Local development only — this key is public. demo/prod refuse it and read theirs from Secret Manager.
SECRET_ENCRYPTION_KEY=Z8hzHf+pb3kjsnM+F2d6M4dOgyCtk50GkW/f8Af5R44=

# Runtime connection: the least-privileged role, subject to row-level security.
DATABASE_URL=postgres://skydra_app:skydra_app@localhost:5433/skydra
# Schema owner (not a superuser), used only by `pnpm db:migrate` and seeding. Never given to the API.
MIGRATION_DATABASE_URL=postgres://skydra_migrator:skydra_migrator@localhost:5433/skydra
# Superuser connection for integration tests; each test file creates its own database.
TEST_DATABASE_URL=postgres://skydra:skydra@localhost:5433/skydra

# Provider adapters (MOCK is refused when APP_ENV=prod; MANUAL = entered by the broker):
#   screening MOCK | MANUAL | OPENSANCTIONS · identity MOCK | MANUAL | DOKOBIT
#   registry  MOCK | MANUAL | REGISTRU_CENTRAS
SCREENING_PROVIDER=MOCK
IDENTITY_PROVIDER=MOCK
REGISTRY_PROVIDER=MOCK
# With SCREENING_PROVIDER=OPENSANCTIONS (key from https://www.opensanctions.org/api):
# OPENSANCTIONS_API_KEY=
# OPENSANCTIONS_THRESHOLD=0.7   # score from which a result must be reviewed (0.5–0.99)
# Adverse media, searched together with OpenSanctions (docs/integrations/adverse-media.md):
# BRAVE_API_KEY=                # Brave Search API; on when set
# GDELT_ENABLED=false           # free, no key; only once the DPIA covers it

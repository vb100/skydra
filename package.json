{
  "name": "skydra",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @skydra/shared build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @skydra/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @skydra/shared build && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/docker/compose.yaml down",
    "test:int": "pnpm --filter @skydra/shared build && pnpm --filter @skydra/api test:int",
    "db:migrate": "pnpm --filter @skydra/api db:migrate",
    "db:seed:platform-admin": "pnpm --filter @skydra/api db:seed:platform-admin",
    "db:seed:demo": "pnpm --filter @skydra/api db:seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
